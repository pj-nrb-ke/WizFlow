{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.wizflow.biz",
        "EXPO_PUBLIC_WEB_URL": "https://app.wizflow.biz"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.wizflow.biz",
        "EXPO_PUBLIC_WEB_URL": "https://app.wizflow.biz"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.wizflow.biz",
        "EXPO_PUBLIC_WEB_URL": "https://app.wizflow.biz"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      }
    }
  }
}
