{
  "expo": {
    "name": "WizFlow",
    "slug": "wizflow",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "wizflow",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#4f46e5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "biz.wizflow.app"
    },
    "android": {
      "package": "biz.wizflow.app"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-notifications"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "wizflow-mobile-placeholder"
      }
    }
  }
}
