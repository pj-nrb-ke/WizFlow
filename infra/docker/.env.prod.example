# Copy to .env.prod on server: /opt/wizflow/infra/docker/.env.prod (chmod 600)
# Generate: openssl rand -hex 32  (JWT_SECRET and POSTGRES_PASSWORD)

POSTGRES_PASSWORD=change-me-generate-on-server
JWT_SECRET=change-me-generate-on-server
JWT_EXPIRE_MINUTES=60
ENVIRONMENT=production
AUTH_COOKIE_SECURE=true
CORS_ORIGINS=https://app.wizflow.biz
APP_URL=https://app.wizflow.biz
FILE_STORAGE_PATH=/app/uploads
AI_API_KEY=
AI_MODEL=gpt-4o-mini
