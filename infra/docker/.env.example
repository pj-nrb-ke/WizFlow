# Copy to .env in this directory: cp .env.example .env

# Host ports (5174 reserved for WizInvest — do not use for WizFlow)
WEB_HOST_PORT=5200
NGINX_HOST_PORT=8090
API_HOST_PORT=8010
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6381

DATABASE_URL=postgresql://wizflow:wizflow@postgres:5432/wizflow_dev
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-use-long-random-string
JWT_EXPIRE_MINUTES=60
FILE_STORAGE_PATH=./uploads/dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
APP_URL=http://localhost:8090
CORS_ORIGINS=http://localhost:5200,http://localhost:8090
