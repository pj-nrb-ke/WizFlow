# Append to /etc/caddy/Caddyfile — do not remove WizCRM blocks.

api.wizflow.biz {
    reverse_proxy 127.0.0.1:8010
}

app.wizflow.biz {
    root * /var/www/wizflow-web
    encode gzip
    file_server
    try_files {path} /index.html

    # Hashed assets (JS/CSS) — cache forever, filename changes on rebuild
    @hashedAssets {
        path /assets/*
    }
    header @hashedAssets Cache-Control "public, max-age=31536000, immutable"

    # HTML entry point — never cache so browser picks up new asset filenames
    @html {
        path *.html
        path /
    }
    header @html Cache-Control "no-cache, no-store, must-revalidate"
}
