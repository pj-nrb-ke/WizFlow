{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wizflow.biz/schemas/workflow-definition.json",
  "title": "WorkflowDefinition",
  "type": "object",
  "required": ["name", "form_schema", "steps"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "company_id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "version": { "type": "integer", "minimum": 1, "default": 1 },
    "status": {
      "type": "string",
      "enum": ["draft", "published", "archived"]
    },
    "form_schema": { "$ref": "form-schema.json" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/WorkflowStep" }
    },
    "routing_rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/RoutingRule" },
      "default": []
    },
    "settings": {
      "type": "object",
      "properties": {
        "sla_hours": { "type": "integer", "minimum": 1 },
        "allow_delegate": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "WorkflowStep": {
      "type": "object",
      "required": ["id", "name", "type", "assignee"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["approval", "notification"] },
        "assignee": { "$ref": "#/$defs/Assignee" },
        "conditions": { "type": "array", "items": { "type": "object" }, "default": [] },
        "fallback_assignee": { "$ref": "#/$defs/Assignee" }
      }
    },
    "Assignee": {
      "type": "object",
      "required": ["type", "value"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["role", "user", "reporting_manager"] },
        "value": { "type": "string" }
      }
    },
    "RoutingRule": {
      "type": "object",
      "required": ["when", "skip_to"],
      "additionalProperties": false,
      "properties": {
        "when": {
          "type": "object",
          "required": ["field", "op", "value"],
          "properties": {
            "field": { "type": "string" },
            "op": { "type": "string", "enum": ["eq", "ne", "gt", "gte", "lt", "lte", "in"] },
            "value": {}
          }
        },
        "skip_to": { "type": "string" }
      }
    }
  }
}
